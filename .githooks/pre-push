#!/bin/sh
# Refuses a push when an offline step of .forgejo/workflows/checks.yaml that the pushed changes touch is
# red. The steps and the paths that pick each are rows of .githooks/pre-push-steps.tsv; CI runs every
# step again after the push as the authority. Never push past it with --no-verify: checks fails the
# same red. Switched on in every clone by the global hook dispatcher in dotfiles (.config/git/hooks);
# from a clone without it, run it by hand: git config core.hooksPath .githooks
#
# Reads git's pre-push lines on stdin. Changed means the pushed commit against the remote's value of the
# branch, or against the merge base with the remote's master for a new branch. The steps read the
# working tree, so a push of a commit other than HEAD runs none. PREPUSH_ALL=1 runs every step.
start=$(date +%s)
refs="$(cat)"
remote="${1:-origin}"
zero=0000000000000000000000000000000000000000
cd "$(git rev-parse --show-toplevel)" || exit 1
# A hook runs with git's repository variables set; the steps' own git calls would inherit them.
# shellcheck disable=SC2046 # one variable name per word
unset $(git rev-parse --local-env-vars)

[ -n "$refs" ] || exit 0
head="$(git rev-parse HEAD)"
changed="$(mktemp)"
trap 'rm -f "$changed"' EXIT
all=${PREPUSH_ALL:-0}
pushed=0
while read -r _lref lsha _rref rsha; do
    [ "$lsha" = "$zero" ] && continue
    if [ "$lsha" != "$head" ]; then
        echo "pre-push: not pushing HEAD, so the steps (which read this tree) do not run" >&2
        continue
    fi
    pushed=1
    if [ "$rsha" != "$zero" ] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
        base="$rsha"
    else
        base="$(git merge-base "$lsha" "$remote/master" 2>/dev/null || git merge-base "$lsha" forgejo/master 2>/dev/null)" || base=""
    fi
    if [ -n "$base" ]; then git diff --name-only "$base" "$lsha" >> "$changed"; else all=1; fi
done <<EOF
$refs
EOF
[ "$pushed" = 1 ] || exit 0
[ -z "$(git status --porcelain)" ] || echo "pre-push: the working tree has uncommitted changes; the steps read them, not the pushed commit" >&2

ran=0
red=""
while IFS="$(printf '\t')" read -r regex needs cmd; do
    case "$regex" in ''|'#'*|-) continue ;; esac
    if [ "$all" != 1 ] && ! grep -Eq "$regex" "$changed"; then continue; fi
    if [ "$needs" != "-" ] && ! command -v "$needs" >/dev/null 2>&1; then
        echo "pre-push: skipped, no $needs here (CI runs it): $cmd"
        continue
    fi
    echo "==> $cmd"
    ran=$((ran + 1))
    if ! sh -c "$cmd" </dev/null; then red="$red
  $cmd"; fi
done < .githooks/pre-push-steps.tsv

echo "pre-push: $ran steps, $(($(date +%s) - start))s"
if [ -n "$red" ]; then
    printf 'pre-push: red, push refused:%s\n' "$red" >&2
    exit 1
fi
