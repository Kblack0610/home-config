# ===================
target/
node_modules/
__pycache__/
*.pyc

# Go binaries and SQLite DBs (actual-budget-tools)
apps/actual-budget-tools/actual-budget-tools
apps/actual-budget-tools/bin/
apps/actual-budget-tools/data/tools.db

