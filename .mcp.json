{
  "mcpServers": {
    "kubernetes": {
      "command": "npx",
      "args": ["-y", "kubernetes-mcp-server@latest"],
      "env": {
        "KUBECONFIG": "${HOME}/.kube/config"
      }
    },
    "home-assistant": {
      "command": "uvx",
      "args": ["ha-mcp"],
      "env": {
        "HOMEASSISTANT_URL": "${HOMEASSISTANT_URL}",
        "HOMEASSISTANT_TOKEN": "${HOMEASSISTANT_TOKEN}"
      }
    },
    "ssh": {
      "command": "npx",
      "args": ["@aiondadotcom/mcp-ssh"]
    },
    "prometheus": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "PROMETHEUS_URL",
        "ghcr.io/pab1it0/prometheus-mcp-server:latest"
      ],
      "env": {
        "PROMETHEUS_URL": "${PROMETHEUS_URL}"
      }
    },
    "grafana": {
      "command": "npx",
      "args": ["-y", "mcp-grafana@latest"],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "digitalocean": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@digitalocean/mcp"
      ],
      "env": {}
    },
    "print": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "${PWD}/apps/print-service/mcp/print_mcp.py"
      ],
      "env": {
        "PRINT_SERVICE_URL": "https://print.kblab.me"
      }
    }
  }
}
