# SOPS-encrypted secrets (group_vars/**/vault.sops.yaml) ARE committed - the
# encryption protects them. Only runtime artifacts and local state below.
*.retry
collections/ansible_collections/
# Failsafe: if someone accidentally creates a plaintext copy of a secrets file
# with a common name, don't ship it.
group_vars/**/vault.plain.yml
group_vars/**/*.unencrypted.yml
group_vars/**/*.dec.yaml
group_vars/**/*.unencrypted.yml
