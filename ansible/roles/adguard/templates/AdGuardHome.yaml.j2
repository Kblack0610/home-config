#jinja2: lstrip_blocks: True, trim_blocks: True
{#
  DO NOT put YAML comments (#) in this template's OUTPUT.

  AdGuard rewrites AdGuardHome.yaml with its own emitter every time it starts,
  and that emitter strips comments. Any comment here therefore reappears as a
  diff on the next converge, so the role would report changed forever and
  restart AdGuard - dropping house DNS - on every single drift check.

  The "managed by Ansible" warning for anyone poking at the host lives in
  README.ANSIBLE next to this file, which AdGuard does not touch.

  Jinja comments like this one are fine: they never reach the output.
#}
http:
  pprof:
    port: 6060
    enabled: false
  address: 0.0.0.0:80
  session_ttl: 720h
{#
  Preserved verbatim from whatever AdGuard already had on the host - see the
  "Preserve the admin credential in place" tasks. Empty on a fresh card, which
  makes AdGuard serve its first-run setup wizard on :3000.
#}
users:
{% for u in adguard_existing_users %}
  - name: {{ u.name }}
    password: {{ u.password }}
{% endfor %}
auth_attempts: 5
block_auth_min: 15
http_proxy: ""
language: ""
theme: auto
dns:
  bind_hosts:
    - 0.0.0.0
  port: 53
  anonymize_client_ip: false
  ratelimit: {{ adguard_ratelimit }}
  ratelimit_subnet_len_ipv4: 24
  ratelimit_subnet_len_ipv6: 56
  ratelimit_whitelist:
{% for client in adguard_ratelimit_whitelist %}
    - {{ client }}
{% endfor %}
  refuse_any: true
  upstream_dns:
{% for server in adguard_upstream_dns %}
    - {{ server }}
{% endfor %}
  upstream_dns_file: ""
  bootstrap_dns:
{% for server in adguard_bootstrap_dns %}
    - {{ server }}
{% endfor %}
  fallback_dns:
{% for server in adguard_fallback_dns %}
    - {{ server }}
{% endfor %}
  upstream_mode: {{ adguard_upstream_mode }}
  fastest_timeout: 1s
  allowed_clients: []
  disallowed_clients: []
  blocked_hosts:
    - version.bind
    - id.server
    - hostname.bind
  trusted_proxies:
    - 127.0.0.0/8
    - ::1/128
  cache_enabled: true
  cache_size: {{ adguard_cache_size }}
  cache_ttl_min: 0
  cache_ttl_max: 0
  cache_optimistic: {{ adguard_cache_optimistic | lower }}
  cache_optimistic_answer_ttl: 30s
  cache_optimistic_max_age: 12h
  bogus_nxdomain: []
  aaaa_disabled: false
  enable_dnssec: false
  edns_client_subnet:
    custom_ip: ""
    enabled: {{ adguard_edns_client_subnet_enabled | lower }}
    use_custom: false
  max_goroutines: 300
  handle_ddr: true
  ipset: []
  ipset_file: ""
  bootstrap_prefer_ipv6: false
  upstream_timeout: {{ adguard_upstream_timeout }}
  private_networks: []
  use_private_ptr_resolvers: false
  local_ptr_upstreams: []
  use_dns64: false
  dns64_prefixes: []
  serve_http3: false
  use_http3_upstreams: false
  serve_plain_dns: true
  hostsfile_enabled: true
  pending_requests:
    enabled: true
tls:
  enabled: false
  server_name: ""
  force_https: false
  port_https: 443
  port_dns_over_tls: 853
  port_dns_over_quic: 853
  port_dnscrypt: 0
  dnscrypt_config_file: ""
  allow_unencrypted_doh: false
  certificate_chain: ""
  private_key: ""
  certificate_path: ""
  private_key_path: ""
  strict_sni_check: false
querylog:
  dir_path: ""
  ignored: []
  interval: {{ adguard_querylog_interval }}
  size_memory: 1000
  enabled: {{ adguard_querylog_enabled | lower }}
  ignored_enabled: false
  file_enabled: {{ adguard_querylog_file_enabled | lower }}
statistics:
  dir_path: ""
  ignored: []
  interval: {{ adguard_statistics_interval }}
  enabled: true
  ignored_enabled: false
filters:
{% for f in adguard_filters %}
  - enabled: {{ f.enabled | lower }}
    url: {{ f.url }}
    name: {{ f.name }}
    id: {{ f.id }}
{% endfor %}
whitelist_filters: []
{# An empty `key:` parses as null, not as an empty list, so emit [] explicitly. #}
user_rules: {% if adguard_user_rules %}

{% for rule in adguard_user_rules %}
  - {{ rule }}
{% endfor %}
{% else %}
[]
{% endif %}
dhcp:
  enabled: false
  interface_name: ""
  local_domain_name: lan
  dhcpv4:
    gateway_ip: ""
    subnet_mask: ""
    range_start: ""
    range_end: ""
    lease_duration: 86400
    icmp_timeout_msec: 1000
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false
filtering:
  blocking_ipv4: ""
  blocking_ipv6: ""
  blocked_services:
    schedule:
      time_zone: Local
    ids: []
  protection_disabled_until: null
  safe_search:
    enabled: false
    bing: true
    duckduckgo: true
    ecosia: true
    google: true
    pixabay: true
    yandex: true
    youtube: true
  blocking_mode: default
  parental_block_host: family-block.dns.adguard.com
  safebrowsing_block_host: standard-block.dns.adguard.com
  rewrites:
{#
  Quote only what YAML actually requires quoting, because AdGuard rewrites this
  file with its own emitter on every start. Always-quoting made `kblab.me` come
  back as `'kblab.me'` and the role reported a change on every single converge.
#}
{% for rw in adguard_rewrites %}
    - domain: {% if rw.domain[0] in '*&!%@`|>#-?:,[]{}' %}'{{ rw.domain }}'{% else %}{{ rw.domain }}{% endif %}

      answer: {{ rw.answer }}
      enabled: {{ rw.enabled | lower }}
{% endfor %}
  safe_fs_patterns:
    - /opt/adguardhome/work/userfilters/*
  safebrowsing_cache_size: 1048576
  safesearch_cache_size: 1048576
  parental_cache_size: 1048576
  cache_time: 30
  filters_update_interval: 24
  blocked_response_ttl: 10
  filtering_enabled: true
  rewrites_enabled: true
  parental_enabled: false
  safebrowsing_enabled: false
  protection_enabled: true
clients:
  runtime_sources:
    whois: true
    arp: true
    rdns: true
    dhcp: true
    hosts: true
  persistent: []
log:
  enabled: true
  file: ""
  max_backups: 0
  max_size: 100
  max_age: 3
  compress: false
  local_time: false
  verbose: false
os:
  group: ""
  user: ""
  rlimit_nofile: 0
schema_version: {{ adguard_schema_version }}
