# Managed by Ansible (roles/audio-endpoint) - do not edit by hand.
# Default ALSA device -> USB balanced interface feeding the Yamaha HS5 pair.
# Referenced by card *id* (name), not index, so it survives USB re-enumeration.
# `type plug` gives automatic rate/format conversion so speaker-test and the
# downstream services (shairport-sync, snapclient) do not have to match the
# hardware params exactly.
pcm.!default {
    type plug
    slave.pcm {
        type hw
        card "{{ audio_endpoint_card_id }}"
    }
}

ctl.!default {
    type hw
    card "{{ audio_endpoint_card_id }}"
}
