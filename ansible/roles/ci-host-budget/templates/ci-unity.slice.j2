# Managed by ansible (ci-host-budget). Every Unity runner on this host, and every
# container its jobs start with docker run --cgroup-parent, runs here, inside the
# host's CI budget ({{ ci_slice }}). A container that names no slice gets
# {{ ci_slice }} itself (docker's default cgroup-parent).
[Unit]
Description=Unity CI runners (GitHub Actions)
Before=slices.target

[Slice]
CPUAccounting=true
CPUWeight={{ ci_unity_cpu_weight }}
{% if ci_unity_cpus %}
AllowedCPUs={{ ci_unity_cpus }}
{% endif %}
MemoryAccounting=true
MemoryMax={{ ci_unity_memory_max }}
