{#
  apps/forgejo/configmap.yaml's app.ini (one source), plus what Forgejo writes
  back into it at start: WORK_PATH, and each FORGEJO__<section>__<KEY> in
  secrets.env (the image's environment-to-ini). Both save only when a value is
  missing or differs, so with them already here Forgejo leaves the file alone
  and the play converges to no change.
#}
{% set ini = (lookup('file', playbook_dir ~ '/../../apps/forgejo/configmap.yaml') | from_yaml).data['app.ini'] %}
{% set env = {} %}
{% for name, value in (vault_forgejo_env | default({})).items() if name.startswith('FORGEJO__') %}
{% set parts = name.split('__') %}
{% set _ = env.setdefault(parts[1], []).append(parts[2] ~ ' = ' ~ value) %}
{% endfor %}
WORK_PATH = /data/gitea
{% for line in ini.splitlines() %}
{{ line }}
{% for kv in env.pop(line[1:-1], []) if line is match('^\\[.+\\]$') %}
{{ kv }}
{% endfor %}
{% endfor %}
{% for section, kvs in env.items() %}

[{{ section }}]
{% for kv in kvs %}
{{ kv }}
{% endfor %}
{% endfor %}
