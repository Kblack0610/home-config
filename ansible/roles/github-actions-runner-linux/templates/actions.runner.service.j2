[Unit]
Description=GitHub Actions self-hosted runner ({{ gh_runner_name }})
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User={{ gh_runner_user }}
Group={{ gh_runner_group }}
WorkingDirectory={{ gh_runner_home }}
# bin/runsvc.sh, not run.sh: it is what the runner's own svc.sh installs, and it
# forwards SIGTERM to the listener. With KillMode=process, run.sh took the
# SIGTERM alone and left Runner.Listener running, so every restart produced a
# second listener stuck on "A session for this runner already exists" while the
# orphan kept taking jobs with the OLD config (2026-09-29, platform CI slots).
# A git lock under the work dir when the runner starts is stale: no job runs
# yet. A host stopped mid-checkout (aws-burst-1 Spot interruption, 2026-11-03)
# left .git/modules/External/asset-library/index.lock in every slot, and each
# later job failed on "File exists" in seconds. "-": a failed sweep must not
# keep the runner down, but a sweep killed by the 90s start timeout still does.
# So it walks only each checkout's .git (work/<repo>/<repo>/.git; submodule git
# dirs live inside it under modules/), pruning everything else at that depth and
# the object stores. Walking the whole work dir took every Unity Library with it: on
# aws-burst-1 after a stop, six cold walks never finished inside 90s, systemd
# restarted each one, and no runner registered for a day of starts (2026-11-05).
# rm, not -delete: -delete turns on -depth, which find refuses next to -prune.
{% set work = gh_runner_work_dir if gh_runner_work_dir.startswith('/') else gh_runner_home ~ '/' ~ gh_runner_work_dir %}
ExecStartPre=-/usr/bin/find {{ work }} ( -path '{{ work }}/*/*/*' ! -path '*/.git' ! -path '*/.git/*' ) -prune -o ( -name objects -o -name lfs ) -prune -o -path '*/.git/*' -name '*.lock' -type f -exec /bin/rm -f {} +
ExecStart={{ gh_runner_home }}/bin/runsvc.sh
Restart=always
RestartSec=5
{% if gh_runner_slice %}
# CPU/memory caps for CI live on the slice, so a burst of jobs cannot starve
# the kubelet on a k3s node.
Slice={{ gh_runner_slice }}
{% endif %}
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
# The runner binary self-updates in-place; don't lock the exec file.
ReadWritePaths={{ gh_runner_home }}

[Install]
WantedBy=multi-user.target
