{# Rendered into {{ mlx_config_path }} on mac-studio. Schema: cubist38 mlx-openai-server. #}
server:
  host: "{{ mlx_host }}"
  port: {{ mlx_port }}
  log_level: {{ mlx_log_level }}

models:
{% for m in mlx_models %}
  - served_model_name: {{ m.served_model_name }}
    model_path: {{ m.model_path }}
    model_type: {{ m.model_type }}
{% if m.on_demand | default(false) %}
    on_demand: true
    on_demand_idle_timeout: {{ m.on_demand_idle_timeout | default(120) }}
{% endif %}
{% if m.context_length is defined %}
    context_length: {{ m.context_length }}
{% endif %}
{% if m.default_max_tokens is defined %}
    default_max_tokens: {{ m.default_max_tokens }}
{% endif %}
{% if m.enable_auto_tool_choice is defined %}
    enable_auto_tool_choice: {{ m.enable_auto_tool_choice | string | lower }}
{% endif %}
{% if m.tool_call_parser is defined %}
    tool_call_parser: {{ m.tool_call_parser }}
{% endif %}
{% if m.reasoning_parser is defined %}
    reasoning_parser: {{ m.reasoning_parser }}
{% endif %}
{% endfor %}
