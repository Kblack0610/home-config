<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ disk_reclaim_label }}</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{ disk_reclaim_script_path }}</string>
    </array>

    <!--
      StartInterval without RunAtLoad: a reclaim pass is not urgent, and firing
      one the moment the agent loads would prune during whatever made you
      reload it. The script itself declines to run while a CI job is in flight.
    -->
    <key>StartInterval</key>
    <integer>{{ disk_reclaim_interval_seconds }}</integer>

    <key>Nice</key>
    <integer>10</integer>

    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{ disk_reclaim_log_dir }}/{{ disk_reclaim_label | replace('com.', '') | replace('.', '-') }}.log</string>

    <key>StandardErrorPath</key>
    <string>{{ disk_reclaim_log_dir }}/{{ disk_reclaim_label | replace('com.', '') | replace('.', '-') }}.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
