#!/bin/sh
# {{ ansible_managed }}
# Managed by ansible/roles/nut. Do not edit by hand.
#
# Runs on the NUT primary (pi5-master), as the nut user, when the ONBATT
# settling timer expires or LOWBATT fires. It pages, then broadcasts FSD:
# every secondary runs its worker-shutdown.sh, and the primary halts after
# FINALDELAY ({{ nut_primary_finaldelay }}s) through primary-shutdown.sh, which
# ends in killpower.
#
# It used to suspend Flux and cordon every node first. Neither ever ran: the nut
# user cannot read the root-only kubeconfig and there is no flux binary here,
# and had they run, the cluster would have stayed cordoned and suspended after
# the power came back.

set -u

REASON="${1:-unknown}"
LOG_TAG="nut-cluster-shutdown"

log() { logger -t "${LOG_TAG}" -p daemon.notice "$*"; }

log "power-loss shutdown (reason=${REASON}): broadcasting FSD"
/etc/nut/ntfy-page.sh "UPS shutting everything down" \
    "Power out (${REASON}): every machine on the UPS is shutting down now." &

if /usr/sbin/upsmon -c fsd; then
    log "FSD broadcast ok"
else
    log "ERROR: upsmon -c fsd failed; nothing is shutting down"
    /etc/nut/ntfy-page.sh "UPS FSD FAILED" \
        "upsmon -c fsd failed on pi5-master: nothing is shutting down before the battery runs out."
fi

exit 0
