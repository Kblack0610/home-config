# {{ ansible_managed }}
# Managed by ansible/roles/nut. Do not edit by hand.
#
# Driver definition for the USB-attached UPS. `port = auto` lets usbhid-ups
# enumerate the first matching device; with only one UPS on the bus this is
# unambiguous.

[{{ nut_ups_name }}]
    driver = {{ nut_ups_driver }}
    port = {{ nut_ups_port }}
    desc = "{{ nut_ups_description }}"
    # CyberPower's USB controller drops off the bus when it is not polled
    # often enough; the usbhid-ups man page recommends these two for CPS, and
    # NUT 2.8.3 made 12 s the CPS default. Debian trixie ships 2.8.1 (30 s).
    pollonly
    pollfreq = 12
