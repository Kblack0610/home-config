#!/bin/sh
# {{ ansible_managed }}
# Managed by ansible/roles/nut. Do not edit by hand.
#
# Dispatched by upssched when a timer fires or an EXECUTE rule matches.
# Argument 1 is the symbolic name from upssched.conf.

set -eu

EVENT="${1:?event name required}"
LOG_TAG="nut-upssched-cmd"

log() { logger -t "${LOG_TAG}" -p daemon.notice "$*"; }

case "${EVENT}" in
    onbatt-settle)
        log "settling timer expired — running cluster-graceful-shutdown.sh"
        /etc/nut/cluster-graceful-shutdown.sh "onbatt-settle"
        ;;
    early-shutdown)
        log "LOWBATT received — running cluster-graceful-shutdown.sh immediately"
        /etc/nut/cluster-graceful-shutdown.sh "lowbatt"
        ;;
    commbad-warn)
        log "WARN: communication with upsd lost"
        ;;
    commok-clear)
        log "communication with upsd restored"
        ;;
    *)
        log "unhandled event: ${EVENT}"
        ;;
esac
