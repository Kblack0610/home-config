<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by Ansible (roles/osquery-agent). Do not edit by hand. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ osquery_macos_label }}</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ osquery_macos_bin }}</string>
        <string>--flagfile={{ osquery_macos_config_dir }}/osquery.flags</string>
        <string>--disable_watchdog</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/osquery/osqueryd.output.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/osquery/osqueryd.error.log</string>
</dict>
</plist>
