# Managed by Ansible (roles/osquery-agent). Do not edit by hand.
# osquery -> FleetDM (apps/fleet) TLS enrollment flags.
--enroll_secret_path={{ osquery_enroll_secret_path }}
--tls_hostname={{ fleet_tls_hostname }}
--host_identifier=uuid
--enroll_tls_endpoint=/api/osquery/enroll
{% if fleet_tls_server_certs %}
--tls_server_certs={{ fleet_tls_server_certs }}
{% endif %}

# config
--config_plugin=tls
--config_tls_endpoint=/api/osquery/config
--config_refresh={{ osquery_config_refresh }}

# logging
--logger_plugin=tls
--logger_tls_endpoint=/api/osquery/log
--logger_tls_period={{ osquery_logger_period }}

# distributed (live queries)
--disable_distributed=false
--distributed_plugin=tls
--distributed_interval={{ osquery_distributed_interval }}
--distributed_tls_max_attempts=3
--distributed_tls_read_endpoint=/api/osquery/distributed/read
--distributed_tls_write_endpoint=/api/osquery/distributed/write
