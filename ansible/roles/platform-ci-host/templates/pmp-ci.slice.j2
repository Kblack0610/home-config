# Managed by ansible (platform-ci-host). Every platform CI runner unit runs in
# this slice, so CI can use at most {{ pmp_ci_cpu_cores }} cores and {{ pmp_ci_memory_max }}
# on this host and cannot starve the kubelet.
#
# Service containers (postgres, mailpit) are started by dockerd and live in
# docker's own cgroup, so they are NOT counted here. They are small; the node,
# tsc, vitest and Chromium processes that dominate a job are.
[Unit]
Description=Platform CI runners (GitHub Actions)
Before=slices.target

[Slice]
CPUAccounting=true
CPUQuota={{ pmp_ci_cpu_cores * 100 }}%
MemoryAccounting=true
MemoryMax={{ pmp_ci_memory_max }}
