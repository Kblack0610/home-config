<?xml version='1.0' encoding='utf-8'?>
<!-- {{ ansible_managed }}: windows-agent-tools, defaults/main.yml. -->
<vdd_settings>
    <monitors>
        <count>1</count>
    </monitors>
    <gpu>
        <friendlyname>default</friendlyname>
    </gpu>
    <global>
{% for r in windows_agent_tools_vdd_resolutions | map(attribute='refresh') | unique %}
        <g_refresh_rate>{{ r }}</g_refresh_rate>
{% endfor %}
    </global>
    <resolutions>
{% for r in windows_agent_tools_vdd_resolutions %}
        <resolution>
            <width>{{ r.width }}</width>
            <height>{{ r.height }}</height>
            <refresh_rate>{{ r.refresh }}</refresh_rate>
        </resolution>
{% endfor %}
    </resolutions>
    <options>
        <CustomEdid>false</CustomEdid>
        <PreventSpoof>false</PreventSpoof>
        <EdidCeaOverride>false</EdidCeaOverride>
        <HardwareCursor>true</HardwareCursor>
        <SDR10bit>false</SDR10bit>
        <HDRPlus>false</HDRPlus>
        <logging>false</logging>
        <debuglogging>false</debuglogging>
    </options>
</vdd_settings>
