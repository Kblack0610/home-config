# Actual Budget Connection
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# URL of your Actual Budget server
ACTUAL_SERVER_URL=http://your-actual-server.local

# Password for your Actual Budget instance
ACTUAL_PASSWORD=your-password-here

# Budget ID (find in Actual Budget settings)
ACTUAL_BUDGET_ID=your-budget-id-here

# REST API Bridge Settings
ACTUAL_API_KEY=your-api-key-here

# Server Settings
PORT=8080
