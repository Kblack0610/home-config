package templates

import (
	"fmt"
	"github.com/kblack0610/actual-budget-tools/internal/models"
)

templ Subscriptions(subs []models.DetectedSubscription, scanning bool, message string) {
	@Layout("Subscriptions") {
		<div class="px-4 py-6 sm:px-0">
			<div class="flex justify-between items-center mb-8">
				<h1 class="text-3xl font-bold text-gray-900">Subscription Detection</h1>
				<button
					hx-post="/subscriptions/scan"
					hx-target="#subscription-list"
					hx-swap="innerHTML"
					hx-indicator="#scan-spinner"
					class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50"
				>
					<span id="scan-spinner" class="htmx-indicator mr-2">
						@Spinner()
					</span>
					Scan Transactions
				</button>
			</div>

			if message != "" {
				@Alert("success", message)
			}

			<div class="bg-white shadow rounded-lg">
				<div class="px-4 py-5 sm:p-6" id="subscription-list">
					if len(subs) == 0 {
						<div class="text-center py-12">
							<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
							</svg>
							<h3 class="mt-2 text-sm font-medium text-gray-900">No subscriptions detected</h3>
							<p class="mt-1 text-sm text-gray-500">Click "Scan Transactions" to analyze your transaction history.</p>
						</div>
					} else {
						@SubscriptionList(subs)
					}
				</div>
			</div>
		</div>
	}
}

templ SubscriptionList(subs []models.DetectedSubscription) {
	<div class="overflow-x-auto">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payee</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Frequency</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Occurrences</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Confidence</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				for _, sub := range subs {
					<tr>
						<td class="px-6 py-4 whitespace-nowrap">
							<div class="text-sm font-medium text-gray-900">{ sub.Payee }</div>
							<div class="text-sm text-gray-500">Last: { sub.LastSeen.Format("Jan 2, 2006") }</div>
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
							{ formatAmount(sub.Amount) }
						</td>
						<td class="px-6 py-4 whitespace-nowrap">
							<span class={ "px-2 inline-flex text-xs leading-5 font-semibold rounded-full", templ.KV("bg-blue-100 text-blue-800", sub.Frequency == "monthly"), templ.KV("bg-purple-100 text-purple-800", sub.Frequency == "yearly"), templ.KV("bg-green-100 text-green-800", sub.Frequency == "weekly") }>
								{ sub.Frequency }
							</span>
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
							{ fmt.Sprintf("%d", sub.OccurrenceCount) }
						</td>
						<td class="px-6 py-4 whitespace-nowrap">
							@ConfidenceBadge(sub.Confidence)
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm">
							<button
								hx-post={ fmt.Sprintf("/subscriptions/queue/%s", sub.ID) }
								hx-swap="outerHTML"
								hx-target="closest tr"
								class="text-indigo-600 hover:text-indigo-900"
							>
								Add to Review
							</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- Bulk action -->
	<div class="mt-4 flex justify-end">
		<button
			hx-post="/subscriptions/queue-all"
			hx-confirm="Add all detected subscriptions to the review queue?"
			class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700"
		>
			Add All to Review Queue
		</button>
	</div>
}

templ ConfidenceBadge(confidence float64) {
	if confidence >= 0.8 {
		<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
			{ fmt.Sprintf("%.0f%%", confidence*100) }
		</span>
	} else if confidence >= 0.6 {
		<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
			{ fmt.Sprintf("%.0f%%", confidence*100) }
		</span>
	} else {
		<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
			{ fmt.Sprintf("%.0f%%", confidence*100) }
		</span>
	}
}

templ QueuedRow() {
	<tr class="bg-green-50">
		<td colspan="6" class="px-6 py-4 text-center text-sm text-green-700">
			Added to review queue
		</td>
	</tr>
}
