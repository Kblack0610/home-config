// Grafana Alloy log shipper (DaemonSet). Two sources per node → Loki:
//   (a) Kubernetes pod logs (via the kubelet API)
//   (b) host journald (k3s-agent, forgejo-runner, actions.runner.*, sshd,
//       and crucially the next boot/power event — the outage-explainability win)

// ---- (a) pod logs -------------------------------------------------------
discovery.kubernetes "pods" {
  role = "pod"
  selectors {
    role  = "pod"
    field = "spec.nodeName=" + sys.env("NODE_NAME")
  }
}

discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    target_label  = "job"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "node"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.write.default.receiver]
}

// ---- (b) host journald --------------------------------------------------
loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__journal__transport"]
    target_label  = "transport"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "host" {
  max_age       = "12h"
  path          = "/var/log/journal"
  relabel_rules = loki.relabel.journal.rules
  labels        = { job = "systemd-journal" }
  forward_to    = [loki.write.default.receiver]
}

// ---- sink ---------------------------------------------------------------
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = { cluster = "home-k3s" }
}

// ---- OTLP receiver (Claude Code telemetry) ------------------------------
// hostPort in daemonset.yaml binds each Alloy pod's 4317 (grpc) and 4318
// (http/protobuf) to its node IP, so any machine that can reach a node can
// send OTLP here with no extra routing.
//
// The workstation env (CLAUDE_CODE_ENABLE_TELEMETRY, OTEL_EXPORTER_OTLP_ENDPOINT
// =http://hp-victus:4318, the per-signal exporters, the traces beta flag) comes
// from ~/.dotfiles/.config/shared-hooks/claude-telemetry.sh, which sets it only
// when hp-victus resolves.
//
// Prerequisite: prometheus.prometheusSpec.enableRemoteWriteReceiver: true
// must be set in apps/monitoring/helm-values.yaml before metrics flow.
otelcol.receiver.otlp "claude_code" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    metrics = [otelcol.exporter.prometheus.otel.input]
    logs    = [otelcol.exporter.loki.otel.input]
    traces  = [otelcol.processor.transform.claude_usage.input]
  }
}

// ---- Traces -> Langfuse -------------------------------------------------
// Claude Code emits spans (claude_code.interaction as the per-prompt root,
// with claude_code.llm_request / .tool / .tool.execution / .hook beneath it)
// when CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1 and OTEL_TRACES_EXPORTER=otlp.
// Until now this receiver had no traces output at all, so every span was
// accepted and silently dropped: the metrics told us a session cost $X, but
// nothing could answer what it actually did.
//
// Langfuse is the right sink rather than Tempo because it is already the
// LLM-observability surface here (apps/litellm forwards gateway traces to
// the same project via its langfuse_otel callback) and it scores/evaluates
// traces, which a generic tracing backend does not.
//
// Alloy is the right junction rather than exporting straight from the
// workstation: the receiver already terminates OTLP on a hostPort on every
// node, so this adds no client-side fan-out and keeps the Langfuse key in
// the cluster instead of in a shell rc file.

// Claude Code's llm_request span carries its tokens as plain input_tokens /
// output_tokens / cache_read_tokens / cache_creation_tokens and sets no
// gen_ai.usage.*, so Langfuse stored every Claude call with empty usage. Map
// them to the GenAI names Langfuse reads. Langfuse treats gen_ai input_tokens
// as cache-INCLUSIVE (it subtracts cache read + creation from it) while Claude
// Code's input_tokens excludes cache, so input is the sum, not a rename.
// cache_creation (not the newer semconv cache_write) because Langfuse 3.x only
// recognises the former as cache creation.
otelcol.processor.transform "claude_usage" {
  error_mode = "ignore"

  trace_statements {
    context    = "span"
    statements = [
      `set(attributes["gen_ai.usage.output_tokens"], Int(attributes["output_tokens"])) where name == "claude_code.llm_request" and attributes["output_tokens"] != nil`,
      `set(attributes["gen_ai.usage.cache_read.input_tokens"], Int(attributes["cache_read_tokens"])) where name == "claude_code.llm_request" and attributes["cache_read_tokens"] != nil`,
      `set(attributes["gen_ai.usage.cache_creation.input_tokens"], Int(attributes["cache_creation_tokens"])) where name == "claude_code.llm_request" and attributes["cache_creation_tokens"] != nil`,
      `set(attributes["gen_ai.usage.input_tokens"], Int(attributes["input_tokens"])) where name == "claude_code.llm_request" and attributes["input_tokens"] != nil`,
      `set(attributes["gen_ai.usage.input_tokens"], attributes["gen_ai.usage.input_tokens"] + Int(attributes["cache_read_tokens"])) where name == "claude_code.llm_request" and attributes["gen_ai.usage.input_tokens"] != nil and attributes["cache_read_tokens"] != nil`,
      `set(attributes["gen_ai.usage.input_tokens"], attributes["gen_ai.usage.input_tokens"] + Int(attributes["cache_creation_tokens"])) where name == "claude_code.llm_request" and attributes["gen_ai.usage.input_tokens"] != nil and attributes["cache_creation_tokens"] != nil`,
      // Fast mode is its own price tier in Langfuse, keyed on
      // model_parameters.speed, which Langfuse builds from gen_ai.request.*.
      `set(attributes["gen_ai.request.speed"], attributes["speed"]) where name == "claude_code.llm_request" and attributes["speed"] != nil`,
      // 1M-context calls arrive as e.g. "claude-opus-5-5[1m]", which no
      // anchored price pattern matches; they bill at the base rate, so price
      // them as the base model. gen_ai.request.model keeps the raw name.
      `set(attributes["langfuse.observation.model.name"], attributes["gen_ai.request.model"]) where name == "claude_code.llm_request" and attributes["gen_ai.request.model"] != nil`,
      `replace_pattern(attributes["langfuse.observation.model.name"], "\\[1m\\]$", "") where name == "claude_code.llm_request" and attributes["langfuse.observation.model.name"] != nil`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.langfuse.input]
  }
}

otelcol.processor.batch "langfuse" {
  // Spans arrive one interaction at a time; batch to avoid a request per span.
  timeout             = "5s"
  send_batch_size     = 256
  send_batch_max_size = 512

  output {
    traces = [otelcol.exporter.otlphttp.langfuse.input]
  }
}

otelcol.exporter.otlphttp "langfuse" {
  client {
    // Langfuse speaks OTLP over HTTP ONLY (HTTP/JSON and HTTP/protobuf); it
    // has no gRPC ingestion endpoint, so this must be otlphttp, not otlp.
    // The base path is /api/public/otel - the exporter appends /v1/traces.
    // In-cluster Service, so this never leaves the node network.
    endpoint = "http://langfuse-web.langfuse.svc.cluster.local:3000/api/public/otel"
    headers = {
      // Basic auth over base64("pk-lf-...:sk-lf-..."), from apps/alloy/secret.sops.yaml.
      "Authorization"                = join(["Basic ", sys.env("LANGFUSE_BASIC_AUTH")], ""),
      "x-langfuse-ingestion-version" = "4",
    }
  }
  // A Langfuse outage must not wedge the metrics/logs pipelines.
  sending_queue {
    enabled    = true
    queue_size = 1000
  }
  retry_on_failure {
    enabled          = true
    initial_interval = "5s"
    max_interval     = "30s"
    max_elapsed_time = "5m"
  }
}

otelcol.exporter.prometheus "otel" {
  forward_to = [prometheus.remote_write.otel.receiver]
}

prometheus.remote_write "otel" {
  endpoint {
    url = "http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090/api/v1/write"
  }
}

otelcol.exporter.loki "otel" {
  forward_to = [loki.write.default.receiver]
}
