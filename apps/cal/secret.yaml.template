# Template for cal-secret. Bootstrap workflow:
#
#   1. Generate secrets:
#        openssl rand -base64 32   # NEXTAUTH_SECRET
#        openssl rand -base64 32   # CALENDSO_ENCRYPTION_KEY
#        openssl rand -base64 32   # POSTGRES_CAL_PASSWORD (also stamped into apps/postgres/secret.yaml)
#
#   2. Get a Gmail app password from https://myaccount.google.com/apppasswords
#      (16-character string, no spaces). Use one of your 5 Gmails as the
#      relay account; that's also EMAIL_SERVER_USER.
#
#   3. Copy this file: `cp apps/cal/secret.yaml.template apps/cal/secret.yaml`
#      Fill in the placeholder values below.
#
#   4. SOPS-encrypt: `sops --encrypt --in-place apps/cal/secret.yaml`
#
#   5. Stamp POSTGRES_CAL_PASSWORD into apps/postgres/secret.yaml (the same
#      value), re-encrypt, then provision the cal role+db on the running
#      Postgres (see docs/runbooks/cal-com-setup.md for the exact psql).
#
#   6. Activate: add `- cal` to apps/kustomization.yaml, commit, push.
#      Flux reconciles.
#
# Ship-state in this repo: secret.yaml.template is committed; secret.yaml is
# SOPS-encrypted at rest in git (per .sops.yaml's `.*secret.*\.yaml$` rule,
# only the stringData values are encrypted, the rest is readable).
apiVersion: v1
kind: Secret
metadata:
  name: cal-secret
  namespace: cal
  labels:
    app.kubernetes.io/name: cal
type: Opaque
stringData:
  # Postgres connection — both URLs point at the shared in-cluster Postgres
  # (apps/postgres/), database `cal`, role `cal`. DATABASE_DIRECT_URL is used
  # by Prisma migrations and bypasses any future pgBouncer; it can be the
  # same as DATABASE_URL when there's no pooler in front of Postgres.
  DATABASE_URL: postgresql://cal:REPLACE_WITH_POSTGRES_CAL_PASSWORD@postgres.databases.svc.cluster.local:5432/cal
  DATABASE_DIRECT_URL: postgresql://cal:REPLACE_WITH_POSTGRES_CAL_PASSWORD@postgres.databases.svc.cluster.local:5432/cal

  # Random 32-byte secrets — generate with `openssl rand -base64 32`.
  NEXTAUTH_SECRET: REPLACE_WITH_OPENSSL_RAND_32
  CALENDSO_ENCRYPTION_KEY: REPLACE_WITH_OPENSSL_RAND_32

  # Gmail SMTP credentials.
  EMAIL_SERVER_USER: REPLACE_WITH_YOUR_GMAIL_ADDRESS
  EMAIL_SERVER_PASSWORD: REPLACE_WITH_GMAIL_APP_PASSWORD_NO_SPACES
