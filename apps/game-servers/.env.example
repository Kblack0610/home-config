# Copy this to .env and set your token.
# The .env file is NOT committed to git (listed in .gitignore).
SERVER_TOKEN=dev-token-change-me

# Image tags to pull from Forgejo container registry (git.kblab.me).
# Leave as "latest" to auto-follow the newest published image, or pin
# to a specific version tag (e.g. SERVER_IMAGE_TAG=0.0.1).
REGISTRY_IMAGE_TAG=latest
SERVER_IMAGE_TAG=latest
