# Template for the OFFICIAL HA spotify integration credentials.
# Fill from `spotify-ha-bootstrap.py` output, then:
#   cp spotify-secret.yaml.template spotify-secret.yaml
#   # paste real values into spotify-secret.yaml
#   sops --encrypt --in-place spotify-secret.yaml
#   # add `- spotify-secret.yaml` to kustomization.yaml resources
# The seed-spotify init container reads these; keys are OPTIONAL so HA boots
# fine without the secret.
apiVersion: v1
kind: Secret
metadata:
  name: spotify-credentials
  namespace: home-assistant
  labels:
    app.kubernetes.io/name: home-assistant
type: Opaque
stringData:
  spotify-client-id: "<client id>"
  spotify-client-secret: "<client secret>"
  spotify-refresh-token: "<refresh token from bootstrap>"
  spotify-user-id: "<spotify user id from bootstrap>"
  spotify-name: "<display name>"
