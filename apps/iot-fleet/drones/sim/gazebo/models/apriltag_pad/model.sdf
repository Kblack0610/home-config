<?xml version="1.0"?>
<!-- tagStandard41h12 is 9x9 cells with the detection border 5 cells wide, so the
     0.36 m printed square has a 0.2 m tag size (detector/config.json). -->
<sdf version="1.9">
  <model name="apriltag_pad">
    <static>true</static>
    <link name="link">
      <visual name="base">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry><plane><normal>0 0 1</normal><size>0.6 0.6</size></plane></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="tag">
        <pose>0 0 0.002 0 0 0</pose>
        <geometry><plane><normal>0 0 1</normal><size>0.36 0.36</size></plane></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/tag41_12_00000.png</albedo_map>
            <roughness>1</roughness><metalness>0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
