<?xml version="1.0"?>
<sdf version="1.9">
  <model name="iris_downcam">
    <include merge="true">
      <uri>model://iris_with_ardupilot</uri>
    </include>

    <!-- Pitched +90 deg about Y: the lens looks down and the top of the image points at the nose. -->
    <link name="downcam_link">
      <pose>0 0 -0.07 0 1.5707963 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="downcam" type="camera">
        <topic>/downcam/image</topic>
        <camera>
          <horizontal_fov>1.6</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.05</near><far>50</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
      </sensor>
    </link>
    <joint name="downcam_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>downcam_link</child>
    </joint>
  </model>
</sdf>
