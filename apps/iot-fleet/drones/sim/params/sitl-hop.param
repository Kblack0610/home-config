# Hop + precision landing parameters for the P0 SITL quad (loaded with --defaults after the
# ArduPilot frame defaults). Stage 1 uses ArduPilot's simulated target (PLND_TYPE=4);
# sitl-gazebo.param switches to the real detector over MAVLink LANDING_TARGET.
# Precision landing
PLND_ENABLED     1
PLND_TYPE        4
PLND_EST_TYPE    1
PLND_STRICT      1
PLND_RET_MAX     3
PLND_TIMEOUT     4
PLND_RET_BEHAVE  0
PLND_XY_DIST_MAX 2.5
PLND_ALT_MIN     0.3
PLND_ALT_MAX     8
# Simulated downward rangefinder (the real quad carries a flow + lidar module)
RNGFND1_TYPE     100
RNGFND1_ORIENT   25
RNGFND1_MIN      0.05
RNGFND1_MAX      8
# Simulated landing target, stage 1 only; hop.py sets SIM_PLD_LAT/LON from home + the pad offset
SIM_PLD_ENABLE   1
SIM_PLD_TYPE     0
SIM_PLD_HEIGHT   0
SIM_PLD_ALT_LMT  15
SIM_PLD_DIST_LMT 10
# Gentle indoor-scale motion
WPNAV_SPEED      100
WPNAV_ACCEL      100
LAND_SPEED       30
PILOT_TKOFF_ALT  1
# Logging and SITL convenience
LOG_DISARMED     0
LOG_BACKEND_TYPE 1
ARMING_CHECK     1
