<!--
  The profilers that fed trace_log, off at the source. The dominant writer was
  the MEMORY profiler, not the query one: 97% of rows came from
  memory_profiler_step, so setting only query_profiler_* would have left almost
  all of the writes in place. Profile settings live in users.d, not config.d.
-->
<clickhouse>
  <profiles>
    <default>
      <memory_profiler_step>0</memory_profiler_step>
      <memory_profiler_sample_probability>0</memory_profiler_sample_probability>
      <query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns>
      <query_profiler_cpu_time_period_ns>0</query_profiler_cpu_time_period_ns>
    </default>
  </profiles>
</clickhouse>
