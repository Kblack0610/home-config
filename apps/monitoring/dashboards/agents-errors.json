{
  "uid": "kb-agents-errors",
  "title": "Agents / Errors and tools",
  "description": "Claude Code's event log in Loki: model call errors and latency, tool and hook behaviour, skills, compactions and prompt search. Loki keeps a year; secrets are redacted by Alloy before they land.",
  "tags": [
    "agents",
    "claude-code",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "regex": "",
        "refresh": 1,
        "options": []
      },
      {
        "name": "search",
        "label": "Search prompts",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "API requests",
      "description": "Model calls over the range.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"claude-code\"} |= \"claude_code.api_request\" [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "API errors",
      "description": "Failed model calls (rate limits, overload, network).",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"claude-code\"} |= \"claude_code.api_error\" [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Tool calls",
      "description": "Tool results over the range.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"claude-code\"} |= \"claude_code.tool_result\" [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Tool failures",
      "description": "Tool results with success=false.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"claude-code\"} |= \"claude_code.tool_result\" | json ok=`attributes.success` | ok=\"false\" [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Rejected tools",
      "description": "Tool calls the permission layer or a hook refused.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"claude-code\"} |= \"claude_code.tool_decision\" | json d=`attributes.decision` | d=\"reject\" [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Compactions",
      "description": "Context compactions, auto and manual.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"claude-code\"} |= \"claude_code.compaction\" [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "API errors by status",
      "description": "Failed model calls per interval, by HTTP status. 429 is rate limiting, 529 overload.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum by (status) (count_over_time({service_name=\"claude-code\"} |= \"claude_code.api_error\" | json status=`attributes.status_code` [$__interval]))",
          "legendFormat": "{{status}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 80,
            "barAlignment": -1,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": false,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10m",
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "API latency by model, p50 and p95",
      "description": "Whole-request duration of model calls (api_request duration_ms).",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} |= \"claude_code.api_request\" | json model=`attributes.model`, d=`attributes.duration_ms` | unwrap d [$__interval]) by (model)",
          "legendFormat": "p95 {{model}}",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.5, {service_name=\"claude-code\"} |= \"claude_code.api_request\" | json model=`attributes.model`, d=`attributes.duration_ms` | unwrap d [$__interval]) by (model)",
          "legendFormat": "p50 {{model}}",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "barAlignment": -1,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": false,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10m",
      "id": 8
    },
    {
      "type": "table",
      "title": "Tools: calls, failures and p95 duration",
      "description": "One row per tool over the range. A tool that fails often or got slow is the lead.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum by (tool) (count_over_time({service_name=\"claude-code\"} |= \"claude_code.tool_result\" | json tool=`attributes.tool_name` [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum by (tool) (count_over_time({service_name=\"claude-code\"} |= \"claude_code.tool_result\" | json tool=`attributes.tool_name`, ok=`attributes.success` | ok=\"false\" [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} |= \"claude_code.tool_result\" | json tool=`attributes.tool_name`, d=`attributes.duration_ms` | unwrap d [$__range]) by (tool)",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "calls",
              "Value #B": "failed",
              "Value #C": "p95"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "calls",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "-",
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Hooks: runs, blocks and p95 duration",
      "description": "One row per hook over the range. Blocks are hooks that stopped a tool call or a turn.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum by (hook) (count_over_time({service_name=\"claude-code\"} |= \"claude_code.hook_execution_complete\" | json hook=`attributes.hook_name` [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum by (hook) (sum_over_time({service_name=\"claude-code\"} |= \"claude_code.hook_execution_complete\" | json hook=`attributes.hook_name`, b=`attributes.num_blocking` | unwrap b [$__range]))",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} |= \"claude_code.hook_execution_complete\" | json hook=`attributes.hook_name`, d=`attributes.total_duration_ms` | unwrap d [$__range]) by (hook)",
          "legendFormat": "__auto",
          "queryType": "instant",
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "runs",
              "Value #B": "blocks",
              "Value #C": "p95"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "-",
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "id": 10
    },
    {
      "type": "bargauge",
      "title": "Skills activated",
      "description": "Skill activations by name over the range.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sort_desc(sum by (skill) (count_over_time({service_name=\"claude-code\"} |= \"claude_code.skill_activated\" | json skill=`attributes[\"skill.name\"]` [$__range])))",
          "legendFormat": "{{skill}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "minVizHeight": 16,
        "maxVizHeight": 22,
        "namePlacement": "left",
        "sizing": "manual"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Compactions per hour",
      "description": "Auto compactions mean a session ran its context full.",
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum by (trigger) (count_over_time({service_name=\"claude-code\"} |= \"claude_code.compaction\" | json trigger=`attributes.trigger` [$__interval]))",
          "legendFormat": "{{trigger}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 80,
            "barAlignment": -1,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": false,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Subagents finished per hour",
      "description": "Subagents that completed, by type.",
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum by (type) (count_over_time({service_name=\"claude-code\"} |= \"claude_code.subagent_completed\" | json type=`attributes.agent_type` [$__interval]))",
          "legendFormat": "{{type}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
