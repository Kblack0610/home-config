        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "langfuse-clickhouse"
        },
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "query": "SELECT DISTINCT service_name FROM default.events_core WHERE start_time > now() - INTERVAL 7 DAY",
        "definition": "",
        "multi": true,
        "includeAll": true,
