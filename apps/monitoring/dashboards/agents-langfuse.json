            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Slowest traces",
      "description": "The 20 longest traces in the range. Click a trace to open it in Langfuse.",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "langfuse-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "langfuse-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT trace_id, project_id, any(trace_name) AS name, any(service_name) AS service, min(start_time) AS started, dateDiff('millisecond', min(start_time), max(end_time)) AS duration, sum(total_cost) AS cost, count() AS spans FROM default.events_core WHERE $__timeFilter(start_time) AND service_name IN (${service:singlequote}) GROUP BY trace_id, project_id ORDER BY duration DESC LIMIT 20",
          "format": 1,
          "queryType": "table",
          "refId": "A"
        }
      ],
      "transformations": [],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "-",
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Langfuse",
                    "url": "https://langfuse.kblab.me/project/${__data.fields.project_id}/traces/${__data.fields.trace_id}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "project_id"
            },
            "properties": [
              {
