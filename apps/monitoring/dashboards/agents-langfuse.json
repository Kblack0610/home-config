    {
      "type": "table",
      "title": "Tools",
      "description": "TOOL spans by name over the range: calls, p95 duration and errors (level ERROR).",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "langfuse-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "langfuse-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT name AS tool, count() AS calls, quantile(0.95)(dateDiff('millisecond', start_time, end_time)) AS p95, countIf(level = 'ERROR') AS errors FROM default.events_core WHERE $__timeFilter(start_time) AND service_name IN (${service:singlequote}) AND type = 'TOOL' GROUP BY tool ORDER BY calls DESC LIMIT 40",
          "format": 1,
          "queryType": "table",
          "refId": "A"
        }
      ],
      "transformations": [],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
