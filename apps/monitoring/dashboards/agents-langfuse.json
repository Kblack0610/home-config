            "type": "grafana-clickhouse-datasource",
            "uid": "langfuse-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT quantile(0.95)(dateDiff('millisecond', start_time, end_time)) FROM default.events_core WHERE $__timeFilter(start_time) AND service_name IN (${service:singlequote}) AND type = 'GENERATION'",
