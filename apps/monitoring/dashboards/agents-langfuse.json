{
  "uid": "kb-agents-langfuse",
  "title": "Agents / Langfuse",
  "description": "Langfuse's spans straight from its ClickHouse (default.events_core, Langfuse v4), read-only. events_core is a ReplacingMergeTree, so counts can run slightly high until ClickHouse merges duplicates. Trace rows link to langfuse.kblab.me.",
  "tags": [
    "agents",
    "claude-code",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
