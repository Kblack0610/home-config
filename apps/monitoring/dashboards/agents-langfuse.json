    {
      "type": "table",
      "title": "Models",
      "description": "One row per model over the range: calls, cost, latency and tokens.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "langfuse-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "langfuse-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT provided_model_name AS model, count() AS calls, sum(total_cost) AS cost, quantile(0.5)(dateDiff('millisecond', start_time, end_time)) AS p50, quantile(0.95)(dateDiff('millisecond', start_time, end_time)) AS p95, sum(usage_details['input']) AS input, sum(usage_details['output']) AS output FROM default.events_core WHERE $__timeFilter(start_time) AND service_name IN (${service:singlequote}) AND type = 'GENERATION' GROUP BY model ORDER BY cost DESC",
          "format": 1,
          "queryType": "table",
          "refId": "A"
        }
      ],
      "transformations": [],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "-",
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
