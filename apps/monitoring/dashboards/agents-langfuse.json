            "uid": "langfuse-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(start_time) AS time, provided_model_name AS model, sum(total_cost) AS cost FROM default.events_core WHERE $__timeFilter(start_time) AND service_name IN (${service:singlequote}) AND type = 'GENERATION' GROUP BY time, model ORDER BY time",
