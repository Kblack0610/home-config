          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(start_time) AS time, provided_model_name AS model, quantile(0.95)(dateDiff('millisecond', start_time, end_time)) AS p95 FROM default.events_core WHERE $__timeFilter(start_time) AND service_name IN (${service:singlequote}) AND type = 'GENERATION' GROUP BY time, model ORDER BY time",
