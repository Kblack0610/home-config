    {
      "type": "timeseries",
      "title": "Spans by type",
      "description": "Spans per interval by Langfuse type (GENERATION, TOOL, SPAN, AGENT).",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "langfuse-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "langfuse-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(start_time) AS time, type, count() AS spans FROM default.events_core WHERE $__timeFilter(start_time) AND service_name IN (${service:singlequote}) GROUP BY time, type ORDER BY time",
          "format": 0,
          "queryType": "timeseries",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 80,
            "barAlignment": -1,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": false,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
