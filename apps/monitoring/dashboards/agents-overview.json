{
  "uid": "kb-agents-overview",
  "title": "Agents / Overview",
  "description": "What the Claude Code fleet is doing and what it costs. Sessions and bench come from the workstation's textfiles (fleet-sessions, fleet-bench, day-log); cost, tokens and output from Claude Code's own OTel metrics. Switch Metrics to 'VictoriaMetrics (long)' for ranges past 7 days.",
  "tags": [
    "agents",
    "claude-code",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "regex": "",
        "refresh": 1,
        "options": []
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "query": "label_values(claude_code_cost_usage_USD_total, project)",
        "definition": "label_values(claude_code_cost_usage_USD_total, project)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "",
        "allValue": ".*"
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "query": "label_values(claude_code_cost_usage_USD_total, model)",
        "definition": "label_values(claude_code_cost_usage_USD_total, model)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "",
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Working",
      "description": "Sessions fleet-sessions files under WORKING right now (agent_sessions).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(max without (instance, job, host) (agent_sessions{bucket=\"WORKING\"}))",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 1
    },
