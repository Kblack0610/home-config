      "id": 4
    },
    {
      "type": "stat",
      "title": "Cost",
      "description": "Claude Code spend over the dashboard range, from claude_code_cost_usage_USD_total (the client's own estimate).",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_code_cost_usage_USD_total{project=~\"$project\", model=~\"$model\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
