{
  "uid": "kb-agents-runners",
  "title": "Agents / Runners and watches",
  "description": "agentctl runners and Sentinel watches as published over MQTT (agent-mqtt-publish -> mosquitto -> mqtt2prom). The numeric fields (updated_epoch, duration_s, outcome_code, since_epoch) start on 2026-10-29.",
  "tags": [
    "agents",
    "claude-code",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "regex": "",
        "refresh": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Runners",
      "description": "agentctl runners publishing state.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(mqtt_failed{topic=~\"agents_.+_runner_.+\"})",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 1
    },
