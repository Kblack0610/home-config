    {
      "type": "table",
      "title": "Runners",
      "description": "One row per runner: when its last run finished, how long it took, and how it went (outcome_code from agent-mqtt-publish: 0 ok, 1 warn for BLOCKED or PENDING, 2 fail for FAILED or STALLED).",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (runner, host) (label_replace(label_replace(max without (instance, pod, container, endpoint, job, namespace, service) (mqtt_updated_epoch{topic=~\"agents_.+_runner_.+\"}), \"runner\", \"$2\", \"topic\", \"agents_(.+?)_runner_(.+)\"), \"host\", \"$1\", \"topic\", \"agents_(.+?)_runner_(.+)\")) * 1000",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (runner, host) (label_replace(label_replace(max without (instance, pod, container, endpoint, job, namespace, service) (mqtt_duration_s{topic=~\"agents_.+_runner_.+\"}), \"runner\", \"$2\", \"topic\", \"agents_(.+?)_runner_(.+)\"), \"host\", \"$1\", \"topic\", \"agents_(.+?)_runner_(.+)\"))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (runner, host) (label_replace(label_replace(max without (instance, pod, container, endpoint, job, namespace, service) (mqtt_outcome_code{topic=~\"agents_.+_runner_.+\"}), \"runner\", \"$2\", \"topic\", \"agents_(.+?)_runner_(.+)\"), \"host\", \"$1\", \"topic\", \"agents_(.+?)_runner_(.+)\"))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (runner, host) (label_replace(label_replace(max without (instance, pod, container, endpoint, job, namespace, service) (mqtt_running{topic=~\"agents_.+_runner_.+\"}), \"runner\", \"$2\", \"topic\", \"agents_(.+?)_runner_(.+)\"), \"host\", \"$1\", \"topic\", \"agents_(.+?)_runner_(.+)\"))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "last run",
              "Value #B": "took",
              "Value #C": "outcome",
              "Value #D": "running"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "last run",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "-",
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "last run"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "took"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "outcome"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "ok",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "WARN",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "FAIL",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "running"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "-"
                      },
                      "1": {
                        "text": "RUNNING",
                        "color": "blue"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
