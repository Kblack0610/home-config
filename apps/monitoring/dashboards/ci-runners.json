          "editorMode": "code",
          "expr": "github_runner_pool_online",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "host": 0,
              "pool": 1,
              "Value #B": 2,
              "Value #A": 3
            },
            "renameByName": {
              "Value #A": "expected",
              "Value #B": "online"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "host",
            "desc": false
          }
        ]
      },
