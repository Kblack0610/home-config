    {
      "type": "table",
      "title": "Slots by host",
      "description": "Roster-first: a host/pool with expected > online has a slot offline or never registered (ansible play not applied).",
      "gridPos": {
        "h": 9,
        "w": 9,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
