{
  "uid": "kb-command-center",
  "title": "Command Center",
  "description": "One glance at everything: cluster, machines, prod, LLM, CI, agents, spend. Status is judged once in the cc:* recording rules (prometheus-rules-command-center.yaml); the hub tmux board reads the same series.",
  "tags": [
    "overview",
    "command-center",
    "fleet",
    "agents",
    "spend"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Fleet / Machines",
      "url": "/d/kb-fleet",
      "type": "link"
    },
    {
      "title": "CI Runners",
      "url": "/d/kb-ci-runners",
      "type": "link"
    },
    {
      "title": "App Health",
      "url": "/d/homelab-app-health",
      "type": "link"
    },
    {
      "title": "k8s Nodes",
      "url": "/d/k8s_views_nodes",
      "type": "link"
    },
    {
      "title": "Gatus",
      "url": "https://gatus.kblab.me",
      "type": "link",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Overall",
      "description": "Worst domain below. Every tile on this board reads the cc:* recording rules in apps/monitoring/prometheus-rules-command-center.yaml.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "cc:overall_status",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "WARN",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "RED",
                  "color": "red",
                  "index": 2
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO DATA",
                  "color": "purple",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
