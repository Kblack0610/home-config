{
  "uid": "emotiv-mini",
  "title": "Emotiv (mac-mini)",
  "tags": [
    "emotiv",
    "eeg",
    "mac-mini"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "description": "Live view of the Emotiv EPOC X bridge on mac-mini (ansible/roles/emotiv-bridge). Lossy summaries from MQTT via mqtt2prom; the record is the encrypted archive on the NAS.",
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Alerts (empty = fine)",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (alertname) (ALERTS{alertname=~\"Emotiv.*\",alertstate=\"firing\"})",
          "legendFormat": "{{alertname}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "none firing"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name"
      },
      "description": "Firing Emotiv alerts: EmotivBridgeStale, EmotivUploadBacklog, EmotivLicenseExpiring (prometheus-rules-emotiv.yaml)."
    },
    {
      "id": 2,
      "title": "Wearing",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mqtt_wearing{topic=\"emotiv_mini_bridge\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO",
                  "color": "text"
                },
                "1": {
                  "text": "YES",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "bridge silent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "From the bridge heartbeat (emotiv/mini/bridge), sent every 60s and at once when a wear starts or ends."
    },
    {
      "id": 3,
      "title": "Worn for",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mqtt_session_seconds{topic=\"emotiv_mini_bridge\"} and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "-",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Battery",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mqtt_battery_percent{topic=\"emotiv_mini_dev\"} and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "not worn",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Contact (sensors at good)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mqtt_contact_good{topic=\"emotiv_mini_dev\"} and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "max": 14,
          "noValue": "not worn",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 14
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Sensors of 14 whose contact quality is 4 (good) in the dev stream."
    },
    {
      "id": 6,
      "title": "EEG quality",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mqtt_eeg_quality{topic=\"emotiv_mini_dev\"} and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 100,
          "noValue": "not worn",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "eq stream overall, 0-100."
    },
    {
      "id": 7,
      "title": "Bridge",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mqtt_up{topic=\"emotiv_mini_bridge\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "STOPPED",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "no heartbeat",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "up from the last heartbeat. A dead bridge leaves its last value here; EmotivBridgeStale is what says it went silent."
    },
    {
      "id": 8,
      "title": "Band power (mean of 14 sensors)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mqtt_theta{topic=\"emotiv_mini_pow\"} and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "legendFormat": "theta"
        },
        {
          "refId": "B",
          "expr": "mqtt_alpha{topic=\"emotiv_mini_pow\"} and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "legendFormat": "alpha"
        },
        {
          "refId": "C",
          "expr": "mqtt_beta_l{topic=\"emotiv_mini_pow\"} and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "legendFormat": "beta_l"
        },
        {
          "refId": "D",
          "expr": "mqtt_beta_h{topic=\"emotiv_mini_pow\"} and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "legendFormat": "beta_h"
        },
        {
          "refId": "E",
          "expr": "mqtt_gamma{topic=\"emotiv_mini_pow\"} and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "legendFormat": "gamma"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Cortex pow, uV^2/Hz, averaged over sensors and the bridge's 1s window; one point per 30s scrape. Log scale."
    },
    {
      "id": 9,
      "title": "Performance metrics (0.1 Hz)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace({__name__=~\"mqtt_(attention|engagement|excitement|long_excitement|stress|relaxation|interest)\",topic=\"emotiv_mini_met\"}, \"metric\", \"$1\", \"__name__\", \"mqtt_(.*)\") and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "legendFormat": "{{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Cortex met. The Basic license sends these at 0.1 Hz, and a metric Cortex has not activated yet is left out."
    },
    {
      "id": 10,
      "title": "Facial events per minute",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(increase({__name__=~\"mqtt_(blink|wink_l|wink_r|look_l|look_r|surprise|frown|clench|smile|laugh|smirk_left|smirk_right)\",topic=\"emotiv_mini_fac\"}[1m]), \"action\", \"$1\", \"__name__\", \"mqtt_(.*)\") > 0",
          "legendFormat": "{{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "bars"
          },
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Counted by the bridge: a change into a non-neutral fac action is one event, so a clench between two scrapes still shows."
    },
    {
      "id": 11,
      "title": "Head motion",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mqtt_motion{topic=\"emotiv_mini_mot\"} and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "legendFormat": "movement (accel spread)"
        },
        {
          "refId": "B",
          "expr": "mqtt_acc_magnitude{topic=\"emotiv_mini_mot\"} and on() (mqtt_wearing{topic=\"emotiv_mini_bridge\"} == 1)",
          "legendFormat": "accel magnitude"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "mot ACCX/Y/Z: the magnitude's mean and its standard deviation over each 1s window. Still head: spread near 0."
    },
    {
      "id": 12,
      "title": "Worn today",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum_over_time(mqtt_wearing{topic=\"emotiv_mini_bridge\"}[1d:1m]) * 60",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Minutes the heartbeat said wearing in the last 24h, sampled each minute."
    },
    {
      "id": 13,
      "title": "Last upload to the NAS",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(mqtt_last_upload_epoch{topic=\"emotiv_mini_bridge\"} > 0) * 1000",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "noValue": "none since the bridge started",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 14,
      "title": "Spool on the mini",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mqtt_spool_bytes{topic=\"emotiv_mini_bridge\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 500000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Chunks not yet on the NAS. Above 0 is normal during a wear; EmotivUploadBacklog says when it is not."
    },
    {
      "id": 15,
      "title": "Last upload error",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mqtt_last_error_code{topic=\"emotiv_mini_bridge\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "none",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Last error code the bridge saw: an rsync exit code, or a Cortex error code (negative). README Troubleshooting."
    }
  ]
}
