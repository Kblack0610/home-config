      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Never enrolled / unknown group",
      "description": "Rostered machines gatus has never heard from. They have no group here precisely because gatus only learns a machine's group when it first pushes. An empty panel is the goal.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (name, group) (fleet_machine_enrolled) == 0",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "Machine",
              "group": "Group",
              "Value": "Enrolled"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "orange",
                  "index": 0,
                  "text": "NEVER REPORTED"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Enrolled"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Roster drift",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "panels": [
        {
          "type": "table",
          "title": "Reporting but NOT rostered",
          "description": "Machines gatus knows that the roster does not, so they are invisible to the health glyph and would never turn it amber if they died. This caught h0002/h0003 on its first run. Empty is the goal; anything here means the roster in apps/fleet-exporter/deployment.yaml and ~/.config/fleet-pulse/env have drifted.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 6,
            "w": 24,
            "x": 0,
            "y": 45
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "editorMode": "code",
              "expr": "max by (name, group) (fleet_machine_unrostered)",
              "format": "table",
              "instant": true,
              "legendFormat": "__auto",
              "range": false,
              "refId": "A"
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true
                },
                "renameByName": {
                  "name": "Machine",
                  "group": "Group",
                  "Value": "Up"
                }
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "align": "auto"
              },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "1": {
                      "color": "green",
                      "index": 0,
                      "text": "UP"
                    },
                    "0": {
                      "color": "red",
                      "index": 1,
                      "text": "DOWN"
