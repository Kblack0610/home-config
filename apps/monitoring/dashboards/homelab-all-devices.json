  "description": "Proxmox-style device overview for homelab — K3s Raspberry Pi nodes + external Mac machines. Unified CPU, memory, disk, uptime and pod count, with per-device drill-down.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "All Devices — Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "1": { "color": "green", "index": 0, "text": "UP" }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "from": null,
                      "result": { "color": "red", "index": 1, "text": "DOWN" }
                    },
                    "type": "special"
                  }
                ]
              },
              { "id": "custom.width", "value": 70 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "gauge", "mode": "basic" }
              },
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 70 },
                    { "color": "red", "value": 90 }
                  ]
                }
              },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory %" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "gauge", "mode": "basic" }
              },
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 70 },
                    { "color": "red", "value": 90 }
                  ]
                }
              },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Disk %" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "gauge", "mode": "basic" }
              },
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 70 },
                    { "color": "red", "value": 90 }
                  ]
                }
              },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Uptime" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Pods" },
            "properties": [
              { "id": "custom.width", "value": 70 },
              { "id": "custom.align", "value": "center" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Device" },
            "properties": [
              { "id": "custom.width", "value": 200 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Drill down to device",
                    "url": "/d/k8s-homelab-devices/homelab-all-devices?var-device=${__data.fields.Device}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Type" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "custom.align", "value": "center" }
            ]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Device" }]
      },
      "pluginVersion": "10.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "up{job=~\"node-exporter|mac-nodes\"}",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "Status"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\",job=~\"node-exporter|mac-nodes\"}[5m])) * 100)",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "CPU"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(1 - node_memory_MemAvailable_bytes{job=~\"node-exporter|mac-nodes\"} / node_memory_MemTotal_bytes) * 100",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "Memory"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\",job=~\"node-exporter|mac-nodes\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\",job=~\"node-exporter|mac-nodes\"}) * 100",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "Disk"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "node_time_seconds{job=~\"node-exporter|mac-nodes\"} - node_boot_time_seconds{job=~\"node-exporter|mac-nodes\"}",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "Uptime"
        }
      ],
      "title": "Device Overview",
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "instance", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "__name__ 5": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true,
              "job 5": true,
              "mountpoint 4": true,
              "fstype 4": true,
              "mountpoint 5": true,
              "fstype 5": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true
            },
            "renameByName": {
              "instance": "Device",
              "Value #Status": "Status",
              "Value #CPU": "CPU %",
              "Value #Memory": "Memory %",
              "Value #Disk": "Disk %",
              "Value #Uptime": "Uptime"
            },
            "indexByName": {
              "instance": 0,
              "Value #Status": 1,
              "Value #CPU": 2,
              "Value #Memory": 3,
              "Value #Disk": 4,
              "Value #Uptime": 5
            }
