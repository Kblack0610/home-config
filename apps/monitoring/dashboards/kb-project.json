          },
          "editorMode": "code",
          "expr": "kb_project_number{project=~\"$project\", dept=\"analytics\", metric=~\"players_now|players_peak_7d|servers_live\"}",
          "legendFormat": "{{metric}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
