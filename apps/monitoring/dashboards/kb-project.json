{
  "uid": "kb-project",
  "title": "Project departments",
  "description": "The per-product numbers behind the department tabs on agents.kblab.me (Analytics, Support, Money, Marketing), recorded as kb_project_number{project, dept, metric} by apps/monitoring/prometheus-rules-kb-project.yaml. Pick a product; a product with no source has no lines. Linked from every department tab.",
  "tags": [
    "projects",
    "departments"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Analytics: who uses it",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Uptime, 7 day",
      "description": "Share of passing probes over the last 7 days, from the blackbox site probes.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "kb_project_number{project=~\"$project\", dept=\"analytics\", metric=~\"uptime_7d\"}",
          "legendFormat": "{{project}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
