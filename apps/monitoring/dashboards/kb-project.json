  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(kb_project_number, project)",
          "refId": "projects"
        },
        "definition": "label_values(kb_project_number, project)",
        "includeAll": true,
        "multi": true,
        "current": {},
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "options": [],
        "allValue": ".*"
