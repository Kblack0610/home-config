{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Disk Temperature",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 70 }
            ]
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "smartctl_device_temperature{device=~\"$device\"}",
          "legendFormat": "{{device}} ({{model_name}})",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Available Spare %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 30 }
            ]
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "smartctl_device_available_spare{device=~\"$device\"}",
          "legendFormat": "{{device}} ({{model_name}})",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Percentage Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "smartctl_device_percentage_used{device=~\"$device\"}",
          "legendFormat": "{{device}} ({{model_name}})",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Power On Hours",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30000 },
              { "color": "red", "value": 50000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "smartctl_device_power_on_seconds{device=~\"$device\"} / 3600",
          "legendFormat": "{{device}} ({{model_name}})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Critical Warnings",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "smartctl_device_critical_warning{device=~\"$device\"}",
          "legendFormat": "{{device}} ({{model_name}})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Media & Data Integrity Errors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "smartctl_device_media_errors{device=~\"$device\"}",
          "legendFormat": "{{device}} ({{model_name}})",
          "refId": "A",
          "instant": true
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["nas", "disk", "smart"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "" },
        "definition": "label_values(smartctl_device, device)",
        "includeAll": true,
        "multi": true,
        "name": "device",
        "query": { "query": "label_values(smartctl_device, device)", "refId": "A" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "title": "NAS Disk Health (SMART)",
  "uid": "nas-disk-health"
}
